# Optional — a free NVD API key raises the rate limit from 5 to 50 requests / 30s.
# Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Backend
# Seconds between NVD calls (defaults: 6.0 without a key, 0.6 with one).
NVD_DELAY=6.0
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
